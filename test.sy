পুরা ক = ১০;
ভাঙ্গা খ = ২০.৫;
পুরা গ;
গ = ক + ৫;

pura x = 50;
bhanga y = 12.5;

পুরা ঋণাত্মক = -১৫;
ভাঙ্গা ঋণাত্মক_ভাঙ্গা = -২.৫;
পুরা বিপরীত_ক = -ক;
পুরা ধনাত্মক_ক = +ক;

পুরা পাটিগণিত = ((ক + ৫) * ২) - (১০ / ২);
ভাঙ্গা ভগ্নাংশ_গণনা = (খ * ২.০) / ৪.০ + ১.২৫;

দেখাও(ক);
দেখাও(খ);
দেখাও(গ);
দেখাও(ঋণাত্মক);
দেখাও(ঋণাত্মক_ভাঙ্গা);
দেখাও(বিপরীত_ক);
দেখাও(পাটিগণিত);
দেখাও(ভগ্নাংশ_গণনা);

জুদি (ক > ৫ এবং খ > ১০.০) {
    দেখাও(১০০);
}

জুদি (ক < ০ অথবা খ > ০.০) {
    দেখাও(২০০);
} নাইলে {
    দেখাও(৩০০);
}

জুদি (ঋণাত্মক == -১৫ এবং বিপরীত_ক != ক) {
    দেখাও(৪০০);
} নাইলে {
    দেখাও(৫০০);
}

zudi (x >= 50 ebong y <= 20.0) {
    dekhaw(x + 10);
} naile {
    dekhaw(0);
}

পুরা কাউন্টার = ০;
জতক্ষণ (কাউন্টার < ৩) {
    কাউন্টার = কাউন্টার + ১;
    দেখাও(কাউন্টার);
}

পুরা মোট_যোগফল = ০;
জতবার (পুরা i = ১; i <= ৫; i = i + ১) {
    মোট_যোগফল = মোট_যোগফল + i;
}
দেখাও(মোট_যোগফল);

pura fact = 1;
for (pura n = 1; n <= 4; n = n + 1) {
    fact = fact * n;
}
dekhaw(fact);
